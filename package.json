{
  "name": "quran-complex-mushaf-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "قارئ مصاحف رقمية متعدد الروايات - إعادة بناء qurancomplex.ly",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
